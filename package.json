{
  "displayName": "Homebridge 2 Cync Lights",
  "name": "homebridge2-cync-lights",
  "version": "2.0.2",
  "description": "Support for Cync Direct Connect lights by GE.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/l33tintheboat/homebridge-cync-lights.git"
  },
